{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zibblu",
  "version": "0.1.2",
  "identifier": "com.zibblu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zibblu",
        "width": 1190,
        "height": 790,
        "minWidth": 480,
        "minHeight": 550,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: zibblu-media: http://zibblu-media.localhost; media-src 'self' blob: zibblu-media: http://zibblu-media.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "licenseFile": "windows-ai-terms.txt",
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "bin/ffmpeg/*": "ffmpeg/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows-client.nsh"
      }
    }
  }
}
